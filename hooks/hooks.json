{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/manifest_hook.py\"",
            "commandWindows": "python \"$env:PLUGIN_ROOT\\hooks\\manifest_hook.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/hooks/manifest_hook.py\"",
            "commandWindows": "python \"$env:PLUGIN_ROOT\\hooks\\manifest_hook.py\""
          }
        ]
      }
    ]
  }
}
