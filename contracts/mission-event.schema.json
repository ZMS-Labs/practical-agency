{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZMS-Labs/practical-agency/contracts/mission-event@1",
  "title": "mission-event@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "mission_id", "mission_revision", "kind", "actor_ref", "recorded_at", "evidence_refs", "payload", "coverage_limits"],
  "properties": {
    "schema": {"const": "mission-event@1"},
    "event_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "mission_revision": {"type": "integer", "minimum": 1},
    "kind": {"type": "string", "minLength": 1},
    "actor_ref": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "payload": {"type": "object"},
    "coverage_limits": {"type": "array", "items": {"type": "string"}}
  }
}
