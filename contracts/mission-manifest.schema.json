{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zms-labs.github.io/practical-agency/contracts/mission-manifest.schema.json",
  "title": "mission-manifest@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mission_id",
    "revision",
    "authority",
    "outcome",
    "truth",
    "state",
    "capabilities",
    "continuity",
    "integrity"
  ],
  "properties": {
    "schema": { "const": "mission-manifest@1" },
    "mission_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_ref",
        "instruction",
        "amendments",
        "permissions",
        "protected_state",
        "acceptable_costs",
        "escalation_required_for",
        "revoked",
        "revocation_reason"
      ],
      "properties": {
        "operator_ref": { "type": "string", "minLength": 1 },
        "instruction": { "type": "string", "minLength": 1 },
        "amendments": { "type": "array" },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "protected_state": { "type": "array", "items": { "type": "string" } },
        "acceptable_costs": { "type": "array", "items": { "type": "string" } },
        "escalation_required_for": { "type": "array", "items": { "type": "string" } },
        "revoked": { "type": "boolean" },
        "revocation_reason": { "type": ["string", "null"] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "desired_state",
        "completion_proof",
        "integrity_guards",
        "scope_proof",
        "stop_conditions"
      ],
      "properties": {
        "desired_state": { "type": "string", "minLength": 1 },
        "completion_proof": { "type": "array", "minItems": 1 },
        "integrity_guards": { "type": "array", "minItems": 1 },
        "scope_proof": { "type": "array", "minItems": 1 },
        "stop_conditions": { "type": "array", "minItems": 1 }
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_refs",
        "verified_facts",
        "assumptions",
        "contradictions",
        "unknowns"
      ],
      "properties": {
        "subject_refs": { "type": "array" },
        "verified_facts": { "type": "array" },
        "assumptions": { "type": "array" },
        "contradictions": { "type": "array" },
        "unknowns": { "type": "array" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completed_actions",
        "current_frontier",
        "blockers",
        "next_action"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "paused",
            "blocked",
            "verifying",
            "completed",
            "cancelled"
          ]
        },
        "completed_actions": { "type": "array" },
        "current_frontier": { "type": "array" },
        "blockers": { "type": "array" },
        "next_action": { "type": ["string", "null"] }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered_at",
        "available",
        "invoked",
        "unavailable",
        "degraded"
      ],
      "properties": {
        "discovered_at": { "type": ["string", "null"] },
        "available": { "type": "array" },
        "invoked": { "type": "array" },
        "unavailable": { "type": "array" },
        "degraded": { "type": "array" }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_checkpoint",
        "durable_artifacts",
        "decisions",
        "external_handoffs",
        "watch_commissions"
      ],
      "properties": {
        "prior_checkpoint": { "type": ["string", "null"] },
        "durable_artifacts": { "type": "array" },
        "decisions": { "type": "array" },
        "external_handoffs": { "type": "array" },
        "watch_commissions": { "type": "array" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_may_self_accept",
        "required_gates",
        "unresolved_verdicts",
        "completion_acceptor"
      ],
      "properties": {
        "actor_may_self_accept": { "const": false },
        "required_gates": { "type": "array" },
        "unresolved_verdicts": { "type": "array" },
        "completion_acceptor": { "type": ["string", "null"] }
      }
    }
  }
}
