{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZMS-Labs/practical-agency/contracts/capability-result@1",
  "title": "capability-result@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "status",
    "artifact_refs",
    "observed_effects",
    "returned_control_point",
    "coverage_limits"
  ],
  "properties": {
    "schema": {
      "const": "capability-result@1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "declined",
        "blocked",
        "failed"
      ]
    },
    "verdict": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_effects": {
      "type": "array",
      "items": {}
    },
    "returned_control_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "revision",
        "frontier_index",
        "label"
      ],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "frontier_index": {
          "type": "integer",
          "minimum": 0
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
