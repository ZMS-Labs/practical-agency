{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zms-labs.github.io/practical-agency/contracts/execution-receipt.schema.json",
  "title": "execution-receipt@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "mission_id",
    "revision",
    "capability_id",
    "status",
    "artifact_refs",
    "observed_effects",
    "external_ref"
  ],
  "properties": {
    "receipt_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "capability_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["completed", "declined", "blocked", "failed"]
    },
    "artifact_refs": { "type": "array", "items": { "type": "string" } },
    "observed_effects": { "type": "array", "items": { "type": "string" } },
    "external_ref": { "type": ["string", "null"] }
  }
}
