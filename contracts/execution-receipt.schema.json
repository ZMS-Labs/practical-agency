{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZMS-Labs/practical-agency/contracts/execution-receipt@1",
  "title": "execution-receipt@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "mission_id",
    "mission_revision",
    "adapter_ref",
    "status",
    "artifact_refs",
    "observed_effects",
    "external_receipt_ref",
    "coverage_limits"
  ],
  "properties": {
    "schema": {
      "const": "execution-receipt@1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_revision": {
      "type": "integer",
      "minimum": 1
    },
    "adapter_ref": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed",
        "declined"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_effects": {
      "type": "array",
      "items": {}
    },
    "external_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "coverage_limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
