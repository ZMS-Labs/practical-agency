{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZMS-Labs/practical-agency/contracts/execution-request@1",
  "title": "execution-request@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "mission_id", "mission_revision", "action"],
  "properties": {
    "schema": {"const": "execution-request@1"},
    "request_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "mission_revision": {"type": "integer", "minimum": 1},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "description", "required_permissions", "touches", "costs", "consequential", "irreversible", "authority_ref", "stop_condition"],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "required_permissions": {"type": "array", "items": {"type": "string"}},
        "touches": {"type": "array", "items": {"type": "string"}},
        "costs": {"type": "array", "items": {"type": "string"}},
        "consequential": {"type": "boolean"},
        "irreversible": {"type": "boolean"},
        "authority_ref": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1}
      }
    }
  }
}
