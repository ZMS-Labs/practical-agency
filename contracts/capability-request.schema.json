{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zms-labs.github.io/practical-agency/contracts/capability-request.schema.json",
  "title": "capability-request@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "mission_id",
    "revision",
    "capability_id",
    "source_sha256",
    "bounded_question",
    "authority_receipt",
    "expected_output_contract",
    "return_point",
    "stop_condition"
  ],
  "properties": {
    "schema": { "const": "capability-request@1" },
    "request_id": { "type": "string", "minLength": 1 },
    "mission_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "capability_id": { "type": "string", "minLength": 1 },
    "source_sha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "bounded_question": { "type": "string", "minLength": 1 },
    "authority_receipt": { "type": "string", "minLength": 1 },
    "expected_output_contract": { "type": ["string", "null"] },
    "return_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_id", "revision", "frontier_index", "label"],
      "properties": {
        "mission_id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "frontier_index": { "type": "integer", "minimum": 0 },
        "label": { "type": "string" }
      }
    },
    "stop_condition": { "type": "string", "minLength": 1 }
  }
}
